<resources>
    <style name="Theme.SagerNet" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Solid</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>

        <item name="colorPrimary">@color/neon_red</item>
        <item name="colorPrimaryDark">@color/neon_red</item> <item name="colorAccent">@color/neon_purple</item>
        <item name="colorMaterial100">@color/neon_green</item>
        <item name="colorMaterial300">@color/neon_blue</item>

        <item name="android:windowBackground">@drawable/bg_soft_mix</item>
        <item name="android:colorBackground">@android:color/transparent</item>

        <item name="android:textColorPrimary">@color/neon_text_dark</item>
        <item name="android:textColorSecondary">@color/neon_purple</item>

        <item name="colorButtonNormal">@color/neon_green</item>
        <item name="android:navigationBarColor">@color/soft_white_base</item>
        <item name="android:windowLightStatusBar">false</item> <item name="tabTextColor">@color/neon_text_dark</item>
        <item name="tabSelectedTextColor">@color/neon_blue</item>
        <item name="tabIndicatorColor">@color/neon_green</item>
        <item name="tabRippleColor">@color/neon_purple</item>
        <item name="whiteOrTextPrimary">@color/neon_text_dark</item>

        <item name="windowActionModeOverlay">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Choice.SagerNet</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.MaterialComponents.MediumComponent</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet</item>
    </style>

    <style name="Theme.SagerNet.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/neon_red</item>
        <item name="colorPrimaryDark">@color/neon_red</item>
        <item name="colorAccent">@color/neon_purple</item>
        <item name="android:windowBackground">@drawable/bg_soft_mix</item> <item name="android:textColorPrimary">@color/neon_text_dark</item>
        <item name="actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Solid</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet</item>
        <item name="windowFixedHeightMajor" type="dimen">95%</item>
    </style>

    <style name="Theme.SagerNet.Pink_SSR">
        <item name="colorPrimary">@color/neon_red</item>
        <item name="colorPrimaryDark">@color/neon_red</item>
        <item name="colorAccent">@color/neon_purple</item>
        <item name="android:windowBackground">@drawable/bg_soft_mix</item>
        <item name="android:textColorPrimary">@color/neon_text_dark</item>
    </style>

    <style name="Theme.SagerNet.Blue">
        <item name="colorPrimary">@color/neon_blue</item>
        <item name="colorPrimaryDark">@color/neon_blue</item>
        <item name="colorAccent">@color/neon_green</item>
        <item name="android:windowBackground">@drawable/bg_soft_mix</item>
        <item name="android:textColorPrimary">@color/neon_text_dark</item>
    </style>

    <style name="Theme.SagerNet.Green">
        <item name="colorPrimary">@color/neon_green</item>
        <item name="colorPrimaryDark">@color/neon_green</item>
        <item name="colorAccent">@color/neon_red</item>
        <item name="android:windowBackground">@drawable/bg_soft_mix</item>
        <item name="android:textColorPrimary">@color/neon_text_dark</item>
    </style>

    <style name="Theme.SagerNet.Purple">
        <item name="colorPrimary">@color/neon_purple</item>
        <item name="colorPrimaryDark">@color/neon_purple</item>
        <item name="colorAccent">@color/neon_blue</item>
        <item name="android:windowBackground">@drawable/bg_soft_mix</item>
        <item name="android:textColorPrimary">@color/neon_text_dark</item>
    </style>

    <style name="AppearanceFoundation.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.MaterialComponents.Button.TextButton.Dialog.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.MaterialComponents.Button.TextButton.Dialog.Primary</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.MaterialComponents.Button.TextButton.Dialog.Flush.Primary</item>
        <item name="android:textColorPrimary">@color/neon_text_dark</item>
        <item name="android:background">@drawable/bg_soft_mix</item>
    </style>

    <style name="Widget.MaterialComponents.Button.TextButton.Dialog.Primary">
        <item name="android:textColor">@color/neon_blue</item>
    </style>

    <style name="Widget.MaterialComponents.Button.TextButton.Dialog.Flush.Primary">
        <item name="android:textColor">@color/neon_blue</item>
    </style>

    <style name="Widget.MaterialComponents.Chip.Choice.SagerNet">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="checkedIconTint">@color/neon_red</item>
        <item name="rippleColor">@color/chip_ripple_color</item>
    </style>

    <style name="Theme.Start" parent="Theme.MaterialComponents.DayNight">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@android:color/transparent</item>
        <item name="colorPrimaryDark">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.SagerNet.Amber"><item name="colorPrimary">@color/neon_red</item><item name="android:windowBackground">@drawable/bg_soft_mix</item></style>
    <style name="Theme.SagerNet.BlueGrey"><item name="colorPrimary">@color/neon_blue</item><item name="android:windowBackground">@drawable/bg_soft_mix</item></style>
    <style name="Theme.SagerNet.Brown"><item name="colorPrimary">@color/neon_red</item><item name="android:windowBackground">@drawable/bg_soft_mix</item></style>
    <style name="Theme.SagerNet.Cyan"><item name="colorPrimary">@color/neon_blue</item><item name="android:windowBackground">@drawable/bg_soft_mix</item></style>
    <style name="Theme.SagerNet.DeepOrange"><item name="colorPrimary">@color/neon_red</item><item name="android:windowBackground">@drawable/bg_soft_mix</item></style>
    <style name="Theme.SagerNet.DeepPurple"><item name="colorPrimary">@color/neon_purple</item><item name="android:windowBackground">@drawable/bg_soft_mix</item></style>
    <style name="Theme.SagerNet.Grey"><item name="colorPrimary">@color/neon_text_dark</item><item name="android:windowBackground">@drawable/bg_soft_mix</item></style>
    <style name="Theme.SagerNet.Indigo"><item name="colorPrimary">@color/neon_blue</item><item name="android:windowBackground">@drawable/bg_soft_mix</item></style>
    <style name="Theme.SagerNet.LightBlue"><item name="colorPrimary">@color/neon_blue</item><item name="android:windowBackground">@drawable/bg_soft_mix</item></style>
    <style name="Theme.SagerNet.LightGreen"><item name="colorPrimary">@color/neon_green</item><item name="android:windowBackground">@drawable/bg_soft_mix</item></style>
    <style name="Theme.SagerNet.Lime"><item name="colorPrimary">@color/neon_green</item><item name="android:windowBackground">@drawable/bg_soft_mix</item></style>
    <style name="Theme.SagerNet.Orange"><item name="colorPrimary">@color/neon_red</item><item name="android:windowBackground">@drawable/bg_soft_mix</item></style>
    <style name="Theme.SagerNet.Red"><item name="colorPrimary">@color/neon_red</item><item name="android:windowBackground">@drawable/bg_soft_mix</item></style>
    <style name="Theme.SagerNet.Teal"><item name="colorPrimary">@color/neon_green</item><item name="android:windowBackground">@drawable/bg_soft_mix</item></style>
    <style name="Theme.SagerNet.Yellow"><item name="colorPrimary">@color/neon_red</item><item name="android:windowBackground">@drawable/bg_soft_mix</item></style>

    <style name="Theme.SagerNet.Dialog.Black"><item name="colorPrimary">@color/neon_text_dark</item></style>
    <style name="Theme.SagerNet.Black"><item name="colorPrimary">@color/neon_text_dark</item><item name="android:windowBackground">@drawable/bg_soft_mix</item></style>

</resources>
